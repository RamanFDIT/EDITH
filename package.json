{
  "name": "edith",
  "version": "1.0.0",
  "description": "Assistant",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "server": "node server.js",
    "prebuild": "cd frontend && npm run build",
    "pack": "electron-builder --dir",
    "predist": "cd frontend && npm run build",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Ramandeep Singh",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@langchain/core": "^1.1.12",
    "@langchain/google-genai": "^2.1.7",
    "@langchain/google-vertexai": "^2.1.21",
    "@langchain/ollama": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "elevenlabs": "^1.59.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.1",
    "googleapis": "^170.1.0",
    "langchain": "^1.2.7",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "open": "^11.0.0",
    "openai": "^6.16.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.raman.edith",
    "productName": "E.D.I.T.H.",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "agent.js",
      "store.js",
      "envConfig.js",
      "bundledConfig.js",
      "oauthService.js",
      "systemPrompt.js",
      "*Tool.js",
      "*tool.js",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "icon.png.bak", "to": "icon.png" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
